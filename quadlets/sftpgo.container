[Unit]
Description=Files server
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=sftpgo
Image=docker.io/drakkan/sftpgo:slim

UserNS=keep-id
NoNewPrivileges=true
ReadOnly=true
DropCapability=all

PublishPort=127.0.0.1:8092:8080
PublishPort=127.0.0.1:8093:10080
PublishPort=2022:2022

Volume=/home/alex/data/sftpgo:/var/lib/sftpgo:Z
Volume=/home/alex/shares/syncthing/bases:/srv/sftpgo/bases:ro,z
Volume=/home/alex/shares/syncthing/data:/srv/sftpgo/data:ro,z
Volume=/home/alex/shares/syncthing/karina:/srv/sftpgo/karina:ro,z
Volume=/home/alex/shares/qbittorrent:/srv/sftpgo/qbittorrent:z
Volume=/home/alex/shares/metube:/srv/sftpgo/metube:z

Environment=SFTPGO_WEBDAVD__BINDINGS__0__PORT=10080

AutoUpdate=registry

[Service]
Restart=always
RestartSec=60s

[Install]
WantedBy=default.target

