[Unit]
Description=Password vault
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=vaultwarden
Image=docker.io/vaultwarden/server:latest
PublishPort=127.0.0.1:8094:80

NoNewPrivileges=true
ReadOnly=true
DropCapability=all
AddCapability=CAP_NET_BIND_SERVICE

Volume=/home/alex/data/vaultwarden:/data:Z

Environment=WEBSOCKET_ENABLED=true
Environment=DOMAIN=https://vaultwarden.homelab.ru
Environment=TZ=Europe/Moscow
Environment=SIGNUPS_ALLOWED=false
Environment=ADMIN_TOKEN='$argon2id$v=19$m=19456,t=2,p=1$+ve8fZg7C7ltvp+6L5VKh6O/2R+1SPkDXSTuS3RLb74$8JhuNX3X3o3q4DieqkdN9drsvWQko5+4TH5eoncJsFQ'
#podman exec -it vaultwarden /vaultwarden hash --preset owasp

AutoUpdate=registry

[Service]
Restart=always
RestartSec=60s

[Install]
WantedBy=default.target

