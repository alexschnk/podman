[Unit]
Description=Local git-repository server
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=forgejo
Image=codeberg.org/forgejo/forgejo:16

NoNewPrivileges=true

PublishPort=127.0.0.1:8086:3000
PublishPort=127.0.0.1:222:22

Volume=/home/alex/data/forgejo:/data:Z
Volume=/etc/localtime:/etc/localtime:ro

AutoUpdate=registry

[Service]
Restart=always
RestartSec=60s

[Install]
WantedBy=default.target

